# ===== Secrets & environment =====
# Local env files (keep the committed template)
.env
.env.*
!.env.example

# API keys mounted as Docker secrets — never commit
secrets/

# ===== Node / TypeScript =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version

# ===== Logs & runtime state =====
*.log
*.pid
*.seed

# ===== Editors & IDEs =====
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# Verification skill evidence (verify-affido-ui)
verify-runs/

# Judge eval output and local model caches (agent/judge-models may hold
# leftovers of the removed GLiNER runtime)
agent/judge-models/
agent/judge-eval/
agent/judge-harvest/
*.woff2
*.mp3
*.srt

# RFC 0024 D5 (as amended 2026-11-12): the operator's real MCP catalog is
# deployment-local — the connected servers and their hosts are operator
# configuration, not portable repo content. The repo ships
# agent/catalog/mcp.json.example (the e2e fake server only); the Dockerfile
# falls back to it when the real file is absent, so a fresh clone still
# builds the image and passes the gate.
agent/catalog/mcp.json
