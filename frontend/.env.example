# Copy to .env.

# Drizzle / better-auth. `docker compose up -d oltp` publishes 15432 on the host.
DATABASE_URL="postgres://pi:pi@localhost:15432/pi"

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Sandbox access, two modes:
# 1) gateway (default): Caddy validates the session cookie and routes to the
#    per-user sandbox. Works for `pnpm dev` on the host.
SANDBOX_GATEWAY_URL="http://localhost:18080"
# 2) trusted caller: set SANDBOX_MANAGER_URL (e.g. http://sandbox-manager:8090)
#    and MANAGER_TOKEN. The app resolves the user sandbox itself and needs to
#    run on the agents network with WEB_CONTAINER set on the manager.
SANDBOX_MANAGER_URL=""
MANAGER_TOKEN=""

# Upper bound for a prompt (tools can run for a while).
SANDBOX_REQUEST_TIMEOUT_MS="180000"

# No mail transport on this stack: the password-reset link goes to the server
# log, and when this is "true" the forgot-password page shows it too. Inline
# delivery reveals which addresses have an account, so keep it off in a
# deployment.
RESET_PASSWORD_LINK_INLINE="true"
